# Segreti locali — mai committare una vera chiave
.env
.env.local

# Strumenti di sviluppo futuri (Node/Vite), se/quando disponibili su questa macchina
node_modules/
dist/
*.log

# File di test temporanei creati durante lo sviluppo (sempre rimossi manualmente,
# ignorati anche qui per sicurezza se uno restasse per errore)
_*.html

# Profilo Chrome effimero dei job (server/jobs/lib/chromeRunner.js) — rimosso a ogni run,
# ignorato anche qui per sicurezza se un run interrotto ne lasciasse uno indietro.
.aurora-chrome-profile-*/

# Configurazione locale dello strumento (permessi Claude Code), non del progetto
.claude/settings.local.json
